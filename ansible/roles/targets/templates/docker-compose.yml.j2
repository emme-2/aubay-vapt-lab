# Target del lab — generato da Ansible.
# IP fissi e alias *.corp.local per una narrativa realistica.

services:

  # ---------- DATACENTER (172.20.10.0/24) ----------
  proxy:
    image: nginx:1.27-alpine
    container_name: vapt-proxy
    volumes:
      - ./proxy/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on: [dvwa]
    networks:
      datacenter:
        ipv4_address: 172.20.10.10
        aliases: [proxy.corp.local]
    restart: unless-stopped

  dvwa:
    image: vulnerables/web-dvwa:latest
    container_name: vapt-dvwa
    networks:
      datacenter:
        ipv4_address: 172.20.10.20
        aliases: [web.corp.local, dvwa.corp.local]
    restart: unless-stopped

  juice:
    image: bkimminich/juice-shop:latest
    container_name: vapt-juice
    networks:
      datacenter:
        ipv4_address: 172.20.10.21
        aliases: [juice.corp.local]
    restart: unless-stopped

  mail:
    build: ./mail
    image: vapt-mail:latest
    container_name: vapt-mail
    networks:
      datacenter:
        ipv4_address: 172.20.10.30
        aliases: [mail.corp.local]
    restart: unless-stopped

  # ---------- UTENTI (172.20.20.0/24) ----------
  ws01:
    build:
      context: ./workstation
      args:
        USER1: jdoe
        PASS1: Password1
        USER2: deploy
        PASS2: deploy
    image: vapt-ws01:latest
    container_name: vapt-ws01
    hostname: ws01
    volumes:
      - ./ws01_notes.txt:/home/jdoe/notes.txt:ro
    networks:
      users:
        ipv4_address: 172.20.20.11
        aliases: [ws01.corp.local]
    restart: unless-stopped

  ws02:
    build:
      context: ./workstation
      args:
        USER1: mrossi
        PASS1: qwerty
        USER2: svc
        PASS2: service
    image: vapt-ws02:latest
    container_name: vapt-ws02
    hostname: ws02
    networks:
      users:
        ipv4_address: 172.20.20.12
        aliases: [ws02.corp.local]
    restart: unless-stopped

  # Desktop grafico "postazione dipendente" per il walk-through (VNC via Guacamole)
  desktop:
    build: ./desktop
    image: vapt-desktop:latest
    container_name: vapt-desktop
    shm_size: "512m"
    environment:
      VNC_PASSWORD: "{{ desktop_vnc_password }}"
      VNC_GEOMETRY: "1360x768"
    networks:
      users:
        ipv4_address: 172.20.20.20
        aliases: [desktop.corp.local]
      datacenter: {}
    restart: unless-stopped

networks:
  datacenter:
    external: true
    name: vapt_datacenter
  users:
    external: true
    name: vapt_users
